node_modules/
dist/
frontend/.vite/

# Environment variables (never commit real secrets)
.env

# Allow the example file
!.env.example

# SQLite databases
*.db
*.db-shm
*.db-wal
# Raw data files (exclude large raw CSVs and generated Parquet, but allow small metadata catalogs)
data/raw/*
!data/raw/.gitkeep
!data/raw/vessels/
!data/raw/vessels/**
!data/raw/flights/
!data/raw/flights/**
data/processed/*
!data/processed/.gitkeep

.DS_Store
Thumbs.db

