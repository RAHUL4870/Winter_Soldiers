# ============================================================
#  NexaFreight Control Tower — Environment Variables
#  Copy to .env and fill in real values (never commit .env)
#
#  Usage:
#    copy .env.example .env
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#    (paste result as JWT_SECRET value)
# ============================================================

# ─── ENVIRONMENT ───────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ─── DATABASE ──────────────────────────────────────────────────────
# config.py builds sqlite+aiosqlite URL from this path automatically.
# Do NOT set DATABASE_URL — it is computed, not read.
DATABASE_PATH=./data/nexafreight.db
TEST_DATABASE_PATH=:memory:

# ─── SECURITY (REQUIRED) ───────────────────────────────────────────
# App will NOT start without JWT_SECRET set.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
BCRYPT_ROUNDS=12

# ─── BACKGROUND WORKERS ────────────────────────────────────────────
# Set to false when doing ML/OR work or running tests locally.
# Set to true when running the full control tower with live feeds.
ENABLE_AIS_LISTENER=true
ENABLE_POSITION_INTERPOLATOR=true
USE_LIVE_AIS=true

# ─── AIS TRACKING ──────────────────────────────────────────────────
# Register free at https://aisstream.io (GitHub OAuth)
# Leave blank to disable live AIS (falls back to replay adapter)
AISSTREAM_API_KEY=

# Path to Parquet files for AIS replay (used when USE_LIVE_AIS=false)
# AIS_REPLAY_DATA_PATH=./data/ais_history/

# ─── LLM: GOOGLE GEMINI (free tier) ────────────────────────────────
# Register free at https://aistudio.google.com
# Leave blank to disable Gemini (falls back to Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── LLM: OLLAMA (local, no API key needed) ────────────────────────
# Install from https://ollama.com — runs locally, no cost
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── CORS ───────────────────────────────────────────────────────────
# Do NOT set ALLOWED_ORIGINS here — config.py expects a JSON list
# and a plain string will crash startup.
# Defaults: ["http://localhost:5173", "http://127.0.0.1:5173"]

# ============================================================
#  BELOW: Not yet implemented in config.py (Phase 5/6/8)
#  Kept as documentation. Uncomment when backend wires them in.
#  Owner: ML/OR Engineer sets defaults, Backend Engineer adds
#         the fields to Settings class in config.py.
# ============================================================

# ─── ROUTING (Phase 1 — Script 05) ─────────────────────────────────
# Register free at https://openrouteservice.org
# ORS_API_KEY=

# ─── MAP TILES (Frontend only — goes in frontend/.env.local) ───────
# Register free at https://maptiler.com
# MAPTILER_API_KEY=

# ─── ANALYTICS (Phase 8) ───────────────────────────────────────────
# DUCKDB_PATH=./nexafreight_analytics.duckdb

# ─── LLM SWITCHING (Phase 7) ───────────────────────────────────────
# USE_GEMINI=true

# ─── DISRUPTION THRESHOLDS (Phase 5) ───────────────────────────────
# PORT_CONGESTION_THRESHOLD: port_activity / baseline ratio.
#   1.4 = trigger disruption when port is 40% above normal.
#   Calibrate from port_daily_stats distribution (90th-95th pctl).
# PORT_CONGESTION_THRESHOLD=1.4

# VESSEL_DELAY_THRESHOLD_PCT: fraction behind planned leg schedule.
#   0.10 = flag when vessel is >10% behind plan.
#   Tune against replay data for acceptable alert volume.
# VESSEL_DELAY_THRESHOLD_PCT=0.10

# ─── FINANCIAL DEFAULTS (Phase 5/6) ────────────────────────────────
# CARBON_PRICE_PER_KG_USD: cost per kg CO2.
#   0.08 = $80/tonne, roughly aligned with EU ETS range.
#   Used in reroute scoring: total_impact includes carbon_cost term.
# CARBON_PRICE_PER_KG_USD=0.08

# DEFAULT_SLA_PENALTY_PCT: % of order value charged on SLA breach.
#   0.05 = 5%, midpoint of typical 2-10% contract range.
#   Applied when order has no explicit penalty clause defined.
# DEFAULT_SLA_PENALTY_PCT=0.05

# ─── OSINT FEEDS (Phase 4 — Intelligence Layer) ────────────────────
# Added per reworked schedule. Not yet implemented.
# GDELT_GEOFENCE_RADIUS_KM=100
# WEATHER_CHECK_INTERVAL_MINUTES=60
# SEISMIC_MIN_MAGNITUDE=5.0
# INTEL_CONFIDENCE_THRESHOLD=0.6
