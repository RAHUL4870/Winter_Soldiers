# NexaFreight Control Tower — Environment Variables
# Copy to .env and fill in real values (never commit .env)

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# --- Database ---
# Path to SQLite database file (created automatically)
DATABASE_PATH=./data/nexafreight.db
TEST_DATABASE_PATH=:memory:

# --- Security (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- External APIs (Optional / Free Tier) ---
# AIS Stream (https://aisstream.io — free tier available)
AISSTREAM_API_KEY=

# Google Gemini (https://ai.google.dev — free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# Ollama (local LLM, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
